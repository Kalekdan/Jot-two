# Docker Compose environment variables for Jot-two
# Fill in tokens and tweak values to switch providers/models/endpoints.

# TELEGRAM_BOT_TOKEN=TELEGRAM_BOT_TOKEN_GOES_HERE
TELEGRAM_POLL_TIMEOUT=20
TELEGRAM_RETRY_DELAY=2

# OPENAI_API_KEY=OPENAI_API_KEY_GOES_HERE
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_ENDPOINT=/v1/chat/completions
OPENAI_MODEL=gpt-5-nano
OPENAI_SYSTEM_PROMPT_FILE=/app/system_prompt.txt
OPENAI_SUMMARY_EVERY_MESSAGES=20
OPENAI_RECENT_MESSAGES_LIMIT=5
OPENAI_TIMEOUT_SECONDS=60